<% layout("/layout/boilerplate")%>

<style>
    
    #filters {
        display: flex;
        flex-direction: row;
        justify-content: space-between;
        flex-wrap: wrap;
        /* margin-right: 2rem; */
    }

    .filter {
        margin-top: 1rem;
        margin-right: 2rem;
        text-align: center;
        opacity: 0.7;
    }

    .filter p{
        font-size: 0.8rem;
    }

    .filter:hover {
        opacity: 1;
        cursor: pointer;
    }

    .tax-info{
        display:none;
    }

    .form-check{
        border:1px solid black;
        border-radius:1rem;
        height:3rem;
        padding:1rem;
        padding-left:3rem
    }
</style>
